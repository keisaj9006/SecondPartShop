# Public app / Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
NEXT_PUBLIC_SITE_URL=https://your-secondpart-domain.example
# Optional compatibility alias. NEXT_PUBLIC_SITE_URL is the canonical value.
NEXT_PUBLIC_APP_URL=
# Public support/privacy address shown on /contact and /privacy.
# Configure a real monitored mailbox before Google Play submission.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Server-only Supabase admin access.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe marketplace payments + seller onboarding.
# Use test credentials until the final production launch gate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional explicit API pins. Leave blank to use the versions pinned in code.
STRIPE_API_VERSION=
STRIPE_CONNECT_API_VERSION=

# Android / mobile production runtime.
# Firebase service-account JSON encoded as base64 for server-side FCM HTTP v1 delivery.
# Never expose this through NEXT_PUBLIC_*.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Optional dedicated authorization secret for the push-dispatch endpoint.
# When blank, CRON_SECRET remains the controlled fallback.
PUSH_DISPATCH_SECRET=
# Public SHA-256 certificate fingerprint set published by /.well-known/assetlinks.json.
# In Production this must contain the Google Play App Signing fingerprint(s), not only the upload key.
# Comma-separated values are supported by the application route.
ANDROID_APP_LINK_SHA256_FINGERPRINTS=

# Server-only OpenAI access for seller AI Listing drafts.
# Never prefix these values with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna in code.
OPENAI_LISTING_MODEL=

# Vercel commerce maintenance endpoint.
# Use a long random server-only value.
CRON_SECRET=

# Optional production operations alert forwarding.
# Structured SECOND_PART_OPS logs work without these values.
OPS_ALERT_WEBHOOK_URL=
# generic | slack | discord
OPS_ALERT_WEBHOOK_KIND=generic
# Optional Bearer token for a protected generic webhook.
OPS_ALERT_WEBHOOK_TOKEN=

# Server-only UK registration lookup.
# Keep all secrets out of NEXT_PUBLIC_* variables.
VEHICLE_LOOKUP_PROVIDER=dvsa_mot_history
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_SCOPE=
DVSA_MOT_TOKEN_URL=
DVSA_MOT_API_KEY=
DVSA_MOT_API_BASE_URL=https://history.mot.api.gov.uk
